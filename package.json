{
  "name": "jalsetu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm --filter @jalsetu/web typecheck",
    "lint": "pnpm typecheck && node scripts/python.mjs -m ruff check services/planner services/cloud",
    "test": "node scripts/python.mjs -m pytest services/planner/tests -q",
    "dev": "node scripts/dev.mjs",
    "start": "pnpm build && node scripts/local-api.mjs --serve-web",
    "test:release": "pnpm build && node scripts/test-local-release.mjs",
    "check:local": "pnpm lint && pnpm test && pnpm test:csv && pnpm test:storage && pnpm test:operations && pnpm test:exports && pnpm test:projects && pnpm test:metrics && pnpm test:revision-diff && pnpm test:report-time && pnpm test:example-guide && pnpm test:history && pnpm test:records && pnpm test:release",
    "build": "pnpm --filter @jalsetu/web build",
    "evaluate": "node scripts/python.mjs -m jalsetu_planner evaluate --fixtures data/evaluation/finish_by_close_parallel --output docs/evaluation.json --markdown docs/evaluation.md",
    "test:api": "node scripts/test-local-api.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:csv": "node scripts/test-csv.mjs",
    "test:operations": "node scripts/test-local-operations.mjs",
    "test:exports": "node scripts/test-exports.mjs",
    "test:projects": "node scripts/test-projects.mjs",
    "test:metrics": "node scripts/test-metrics.mjs",
    "infra:test": "node infra/test-foundation.mjs",
    "test:container": "node scripts/test-container.mjs",
    "estimate:aws": "node scripts/estimate-aws-cost.mjs",
    "test:revision-diff": "node scripts/test-revision-diff.mjs",
    "test:report-time": "node scripts/test-report-time.mjs",
    "evidence:manifest": "node scripts/evidence-manifest.mjs",
    "test:example-guide": "node scripts/test-example-guide.mjs",
    "test:site-closure": "node scripts/test-local-site-closure.mjs",
    "prepare:hosting": "node scripts/prepare-hosted-web.mjs",
    "test:hosting": "node scripts/test-hosted-web.mjs",
    "check:hosting": "pnpm build && pnpm infra:test && pnpm test:hosting",
    "collect:roads": "node scripts/python.mjs -m jalsetu_planner.public_roads collect",
    "evaluate:roads": "node scripts/python.mjs -m jalsetu_planner.public_roads evaluate",
    "render:roads": "node scripts/python.mjs -m jalsetu_planner.public_roads render",
    "test:records": "node scripts/test-records.mjs",
    "test:history": "node scripts/test-history.mjs"
  },
  "devDependencies": {
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "typescript": "7.0.2"
  }
}
