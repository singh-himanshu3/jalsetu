DEMO_OFFLINE=true
AWS_LIVE=false
# Configure these only after reviewing cloud costs. Never put secrets here.
AWS_REGION=
BEDROCK_MODEL_ID=

# Optional local account-auth review: copy public values to apps/web/.env.local.
VITE_JALSETU_AUTH_MODE=
VITE_JALSETU_AUTH_PROVIDER=Email
VITE_JALSETU_API_BASE_URL=https://API_ID.execute-api.ap-south-1.amazonaws.com/prod
VITE_JALSETU_COGNITO_CLIENT_ID=PUBLIC_COGNITO_APP_CLIENT_ID
VITE_JALSETU_COGNITO_DOMAIN=https://COGNITO_DOMAIN.auth.ap-south-1.amazoncognito.com
VITE_JALSETU_COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/USER_POOL_ID
VITE_JALSETU_CALLBACK_URL=http://localhost:5173/auth/callback
VITE_JALSETU_LOGOUT_URL=http://localhost:5173/
VITE_JALSETU_EXPIRES_AT=2026-10-17T17:27:30Z
# Explicit offline developer workspace at /local-workspace, loopback only.
# Never grants access to /workspace; not an authentication fallback.
VITE_JALSETU_LOCAL_DEVELOPMENT=false

# Infrastructure uses email/password only. No Google OAuth secrets are needed.
JALSETU_AUTH_PROVIDER=Email
